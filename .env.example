# Để trống hai dòng đầu thì app chạy ở chế độ demo, dữ liệu chỉ nằm trên máy.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Maptiles key của Goong (không phải API key). Để trống thì app dùng sơ đồ vẽ tay.
EXPO_PUBLIC_GOONG_MAPTILES_KEY=
# Chỉ đặt ở Supabase Edge Function secrets, không đưa vào app:
# ANTHROPIC_API_KEY=
# AI_REVIEW_MODEL=claude-haiku-5-5
# AI_REVIEW_INCLUDE_IMAGES=true
