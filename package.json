{
  "name": "meetlore-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test tests/*.test.ts",
    "test:db": "bash supabase/tests/run.sh",
    "build:web": "expo export --platform web",
    "test:i18n": "node --experimental-strip-types scripts/check-translations.ts",
    "build:site": "node --experimental-strip-types --no-warnings scripts/build-site.ts"
  },
  "dependencies": {
    "@expo-google-fonts/be-vietnam-pro": "^0.4.1",
    "@expo-google-fonts/lora": "^0.4.2",
    "@expo/metro-runtime": "~58.0.17",
    "@maplibre/maplibre-react-native": "^11.5.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.119.0",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.21",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.12",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-local-authentication": "~58.0.3",
    "expo-location": "~58.0.22",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-task-manager": "~58.0.14",
    "maplibre-gl": "^6.19.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "^15.16.0",
    "react-native-view-shot": "^6.1.1",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
